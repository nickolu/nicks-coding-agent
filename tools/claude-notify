#!/usr/bin/env python3
"""Send a notification via the Discord bridge socket.

Usage:
  claude-notify "message"
  echo "message" | claude-notify
  claude-notify --channel 1500961760117522563 "message"

Flags:
  --channel <id>   Post to a Discord channel by ID.
                   Example: claude-notify --channel 1500961760117522563 "done"
  --dm             Force a DM to Nick even when CLAUDE_CHANNEL_ID is set.

Destination defaults to the channel Howl was invoked from (the bot exports it as
CLAUDE_CHANNEL_ID into the container). With no channel known, it DMs Nick.
"""
import argparse
import json
import os
import socket
import sys

SOCKET = "/run/claude-discord.sock"
# Set by the bot when it launches Claude for a channel (DM or guild channel).
DEFAULT_CHANNEL_ID = os.environ.get("CLAUDE_CHANNEL_ID", "")


def send(payload_or_text) -> None:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(SOCKET)
    if isinstance(payload_or_text, dict):
        s.sendall(json.dumps(payload_or_text).encode("utf-8"))
    else:
        s.sendall(payload_or_text.encode("utf-8"))
    s.shutdown(socket.SHUT_WR)
    s.recv(16)  # consume ack
    s.close()


def main() -> int:
    p = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument(
        "--channel",
        default=DEFAULT_CHANNEL_ID,
        metavar="CHANNEL_ID",
        help="Discord channel ID to post to (default: $CLAUDE_CHANNEL_ID, else DM to Nick).",
    )
    p.add_argument(
        "--dm",
        action="store_true",
        help="Send as a DM to Nick, ignoring CLAUDE_CHANNEL_ID.",
    )
    p.add_argument("message", nargs="*", help="Message text. Falls back to stdin if omitted.")
    args = p.parse_args()

    msg = " ".join(args.message).strip() if args.message else sys.stdin.read().strip()
    if not msg:
        return 0

    channel = "" if args.dm else args.channel
    try:
        if channel:
            send({"type": "notify", "message": msg, "channel_id": channel})
        else:
            send(msg)
    except FileNotFoundError:
        print(f"claude-notify: socket {SOCKET} not found", file=sys.stderr)
        return 1
    except Exception as e:
        print(f"claude-notify: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
