#!/usr/bin/env python3
"""Send a notification via the Discord bridge socket.

Usage:
  claude-notify "message"
  echo "message" | claude-notify
  claude-notify --channel 1500961760117522563 "message"

Flags:
  --channel <id>   Post to a Discord channel by ID instead of DMing Nick.
                   Example: claude-notify --channel 1500961760117522563 "done"
"""
import argparse
import json
import socket
import sys

SOCKET = "/run/claude-discord.sock"


def send(payload_or_text) -> None:
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.connect(SOCKET)
    if isinstance(payload_or_text, dict):
        s.sendall(json.dumps(payload_or_text).encode("utf-8"))
    else:
        s.sendall(payload_or_text.encode("utf-8"))
    s.shutdown(socket.SHUT_WR)
    s.recv(16)  # consume ack
    s.close()


def main() -> int:
    p = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument(
        "--channel",
        default="",
        metavar="CHANNEL_ID",
        help="Discord channel ID to post to (default: DM to Nick).",
    )
    p.add_argument("message", nargs="*", help="Message text. Falls back to stdin if omitted.")
    args = p.parse_args()

    msg = " ".join(args.message).strip() if args.message else sys.stdin.read().strip()
    if not msg:
        return 0

    try:
        if args.channel:
            send({"type": "notify", "message": msg, "channel_id": args.channel})
        else:
            send(msg)
    except FileNotFoundError:
        print(f"claude-notify: socket {SOCKET} not found", file=sys.stderr)
        return 1
    except Exception as e:
        print(f"claude-notify: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
