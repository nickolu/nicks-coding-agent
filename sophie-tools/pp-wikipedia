#!/usr/bin/env python3
"""Zero-cost Wikipedia reference lookups via the public REST API.

Usage:
  pp-wikipedia "Albert Einstein"
  pp-wikipedia "San Diego" --sentences 5
  pp-wikipedia "Python programming language" --format json

Fetches the article summary (intro paragraphs) for the best-matching
Wikipedia article. No authentication required.

Flags:
  --sentences N    Truncate extract to first N sentences (default: all)
  --format json    Machine-readable output with title, description, url
  --lang CODE      Wikipedia language (default: en)
"""
import argparse
import json
import sys
import urllib.parse
import urllib.request

BASE = "https://{lang}.wikipedia.org"
SUMMARY_URL = BASE + "/api/rest_v1/page/summary/{title}"
SEARCH_URL = BASE + "/w/api.php?action=query&list=search&srsearch={q}&format=json&srlimit=1"

USER_AGENT = "nicks-coding-agent/1.0 (personal assistant; contact via github.com/nickolu/nicks-coding-agent)"


def fetch(url: str) -> dict:
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=10) as resp:
        return json.loads(resp.read().decode("utf-8"))


def search_title(query: str, lang: str) -> str | None:
    """Return the best Wikipedia page title for a free-text query."""
    url = SEARCH_URL.format(lang=lang, q=urllib.parse.quote(query))
    data = fetch(url)
    results = data.get("query", {}).get("search", [])
    if not results:
        return None
    return results[0]["title"]


def get_summary(title: str, lang: str) -> dict:
    """Fetch the REST v1 summary for an exact title."""
    url = SUMMARY_URL.format(lang=lang, title=urllib.parse.quote(title.replace(" ", "_")))
    return fetch(url)


def truncate_sentences(text: str, n: int) -> str:
    """Keep at most n sentences from text."""
    import re
    # Split on sentence-ending punctuation followed by whitespace or end
    parts = re.split(r"(?<=[.!?])\s+", text.strip())
    return " ".join(parts[:n])


def main() -> int:
    p = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("query", nargs="+", help="Search query or Wikipedia article title.")
    p.add_argument("--sentences", type=int, default=0, metavar="N",
                   help="Truncate to first N sentences (default: show full extract).")
    p.add_argument("--format", choices=("text", "json"), default="text")
    p.add_argument("--lang", default="en", metavar="CODE",
                   help="Wikipedia language code (default: en).")
    args = p.parse_args()

    query = " ".join(args.query).strip()

    try:
        # Try direct title lookup first; fall back to search.
        title = search_title(query, args.lang)
        if not title:
            print(f"pp-wikipedia: no results for {query!r}", file=sys.stderr)
            return 1
        data = get_summary(title, args.lang)
    except urllib.error.HTTPError as e:
        print(f"pp-wikipedia: HTTP {e.code} fetching {query!r}", file=sys.stderr)
        return 1
    except Exception as e:
        print(f"pp-wikipedia: {e}", file=sys.stderr)
        return 1

    page_title = data.get("title", title)
    description = data.get("description", "")
    extract = data.get("extract", "(no summary available)")
    url = data.get("content_urls", {}).get("desktop", {}).get("page", "")

    if args.sentences > 0:
        extract = truncate_sentences(extract, args.sentences)

    if args.format == "json":
        print(json.dumps({
            "title": page_title,
            "description": description,
            "extract": extract,
            "url": url,
            "lang": args.lang,
        }, ensure_ascii=False, indent=2))
        return 0

    parts = [f"**{page_title}**"]
    if description:
        parts.append(f"_{description}_")
    parts.append("")
    parts.append(extract)
    if url:
        parts.append(f"\n{url}")
    print("\n".join(parts))
    return 0


if __name__ == "__main__":
    sys.exit(main())
