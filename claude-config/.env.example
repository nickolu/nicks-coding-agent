GH_TOKEN=REPLACE_WITH_FINE_GRAINED_PAT
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com
GIT_COMMITTER_NAME=Your Name
GIT_COMMITTER_EMAIL=you@example.com

# howl-post channel name resolution: HOWL_CHANNEL_<NAME>=<discord_channel_id>
# Example: HOWL_CHANNEL_HOWL=1500961760117522563
HOWL_CHANNEL_HOWL=REPLACE_WITH_HOWL_CHANNEL_ID

# howl-post @-tag targets: resolves --tag sophie / --tag nick
SOPHIE_DISCORD_USER_ID=REPLACE_WITH_SOPHIE_BOT_USER_ID
NICK_DISCORD_USER_ID=REPLACE_WITH_NICK_DISCORD_USER_ID

# howl-post rate limit in seconds (default 60). Lower for testing, keep high in prod.
# HOWL_POST_RATE_SEC=60
